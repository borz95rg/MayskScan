<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="horizontal"
    android:padding="8dp">

    <LinearLayout
        android:id="@+id/w_scan"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        
        android:background="@drawable/widget_btn"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="6dp">
        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="Скан"
            android:src="@drawable/ic_scan"
            android:tint="#FF4DA3FF" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:text="Скан"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_ocr"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="6dp"
        android:background="@drawable/widget_btn"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="6dp">
        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="Текст"
            android:src="@drawable/ic_ocr"
            android:tint="#FF4DA3FF" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:text="Текст"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_qr"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="6dp"
        android:background="@drawable/widget_btn"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="6dp">
        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="QR"
            android:src="@drawable/ic_qr"
            android:tint="#FF4DA3FF" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:text="QR"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_id"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="6dp"
        android:background="@drawable/widget_btn"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="6dp">
        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="ID-карта"
            android:src="@drawable/ic_doc"
            android:tint="#FF4DA3FF" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:text="ID-карта"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
